# Copy to .env.local and fill in. Every variable is optional: without an AI
# key the app still analyses, scores and builds resumes; only the optional AI
# rewrites, explanations and reviews are hidden.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public base URL, used for canonical links/metadata and sent to OpenRouter as
# the HTTP-Referer attribution header. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI features (optional). Scoring never uses AI.
#
# GEMINI_API_KEY is the main key. OPENROUTER_API_KEY is an optional backup:
# if a Gemini request fails (invalid/expired key, quota or billing limit,
# timeout, outage), the same request is retried once on OpenRouter.
# Set either one, or both. With neither, AI buttons are hidden.
# ---------------------------------------------------------------------------
# Main: Google Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Default: gemini-3.1-flash-lite (cheapest Gemini tier).
GEMINI_MODEL=gemini-3.1-flash-lite

# Backup: OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# Comma-separated free models, tried in order (OpenRouter skips busy ones).
# Free models are rate limited and change over time; see
# https://openrouter.ai/models?max_price=0 and update the list if one disappears.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# Which provider is tried first: "gemini" (default) or "openrouter".
LLM_PROVIDER=gemini

# Output token budget for the structured tasks (batch bullet rewrites, the
# LinkedIn review, the resume generator). Plain rewrites stay at 400 tokens.
# Raise it if long resumes come back as "unavailable" (truncated JSON), e.g.
# 6000 on a paid tier. Clamped to 800..16000. Default 3000.
LLM_STRUCTURED_MAX_TOKENS=3000

# ---------------------------------------------------------------------------
# Abuse limits (per-route limits live in src/lib/security/rate-limit.ts)
# ---------------------------------------------------------------------------
# Total AI calls per day across ALL users (an extra cap on top of the provider
# quotas below). Defaults to GEMINI_RPD + OPENROUTER_RPD.
LLM_DAILY_CEILING=495

# Optional: shared rate-limit store. Without it, limits are counted per server
# instance (fine for one server; on Vercel each instance counts separately).
# Create a free Upstash Redis database and paste its REST URL and token here
# (Vercel KV's KV_REST_API_URL / KV_REST_API_TOKEN also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# AI provider quotas (whole site, all visitors combined)
# The site never sends a provider more than these; when Gemini's minute/day
# budget is spent, requests go to the OpenRouter backup, and only when both are
# spent do visitors see "AI is busy / used up for today".
# Set each to ~90% of your real limits.
# ---------------------------------------------------------------------------
# Gemini: AI Studio -> your project -> Rate limits (per PROJECT, not per key;
# RPD resets at midnight Pacific). A Google AI Plus/Pro subscription does NOT
# change these; only enabling billing (Tier 1+) raises them.
# gemini-3.1-flash-lite free tier: 15 RPM, 250K TPM, 500 RPD (AI Studio, Oct 2026) -> ~90%.
GEMINI_RPM=13
GEMINI_RPD=450
# OpenRouter free models: 20/min; 50/day with < 10 credits bought (1000/day
# with >= 10). Resets at midnight UTC.
OPENROUTER_RPM=16
OPENROUTER_RPD=45
